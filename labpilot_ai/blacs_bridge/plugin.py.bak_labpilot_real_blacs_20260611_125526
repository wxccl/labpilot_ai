from __future__ import annotations

import json
import os
import queue
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from typing import Any

try:
    from PyQt5 import QtCore
except Exception:  # pragma: no cover
    QtCore = None

from labpilot_ai.blacs_bridge.introspection import (
    candidates_to_json,
    discover_blacs_manual_candidates,
    set_candidate_value,
    values_from_candidates,
)


class _QtInvoker(QtCore.QObject if QtCore is not None else object):
    if QtCore is not None:
        set_requested = QtCore.pyqtSignal(dict, object)

    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin
        if QtCore is not None:
            self.set_requested.connect(self._handle_set)

    if QtCore is not None:
        @QtCore.pyqtSlot(dict, object)
        def _handle_set(self, payload: dict[str, Any], result_queue):
            try:
                result_queue.put(self.plugin._set_manual_in_blacs_thread(payload))
            except Exception as exc:
                result_queue.put({"ok": False, "error": repr(exc)})


class Plugin:
    """
    BLACS-side LabPilot AI bridge plugin.

    This plugin must be loaded by BLACS. It starts a localhost HTTP server inside the
    BLACS process so external LabPilot AI can discover manual controls.

    Default behavior is read-only. To allow experimental manual writes, set:
        LABPILOT_BLACS_ALLOW_WRITE=1
    before starting BLACS. Even then, only generic Qt widget setters are attempted.
    Real hardware programming may require a BLACS/device-specific API and readback.
    """

    def __init__(self, initial_settings=None):
        self.initial_settings = initial_settings or {}
        self.BLACS = None
        self.server = None
        self.thread = None
        self.host = self.initial_settings.get("host", os.environ.get("LABPILOT_BLACS_HOST", "127.0.0.1"))
        self.port = int(self.initial_settings.get("port", os.environ.get("LABPILOT_BLACS_PORT", "8765")))
        self.allow_write = str(os.environ.get("LABPILOT_BLACS_ALLOW_WRITE", "0")).lower() in {"1", "true", "yes", "on"}
        self.invoker = _QtInvoker(self) if QtCore is not None else None

    def plugin_setup_complete(self, BLACS):
        self.BLACS = BLACS
        self.start_server()

    def close(self):
        if self.server is not None:
            try:
                self.server.shutdown()
            except Exception:
                pass
            self.server = None

    # BLACS plugin API compatibility methods.
    def get_callbacks(self):
        return []

    def get_menu_class(self):
        return None

    def get_notification_classes(self):
        return []

    def get_setting_classes(self):
        return []

    def get_save_data(self):
        return {}

    def set_menu_instance(self, menu):
        pass

    def set_notification_instances(self, notifications):
        pass

    def start_server(self):
        plugin = self

        class Handler(BaseHTTPRequestHandler):
            def do_GET(self):
                if self.path == "/status":
                    self._send(
                        {
                            "ok": True,
                            "service": "labpilot-real-blacs-bridge",
                            "bridge_type": "real_blacs_plugin",
                            "has_blacs": plugin.BLACS is not None,
                            "allow_write": plugin.allow_write,
                            "host": plugin.host,
                            "port": plugin.port,
                        }
                    )
                    return
                if self.path == "/debug":
                    blacs = plugin.BLACS
                    self._send(
                        {
                            "ok": True,
                            "service": "labpilot-real-blacs-bridge",
                            "blacs_type": str(type(blacs)),
                            "blacs_attrs": sorted([x for x in dir(blacs) if not x.startswith("__")])[:500] if blacs is not None else [],
                            "blacs_dict_keys": sorted(list(getattr(blacs, "__dict__", {}).keys())) if blacs is not None else [],
                        }
                    )
                    return
                if self.path == "/channels":
                    candidates = plugin._discover_candidates()
                    self._send({"ok": True, "channels": candidates_to_json(candidates)})
                    return
                if self.path == "/values":
                    candidates = plugin._discover_candidates()
                    self._send({"ok": True, "values": values_from_candidates(candidates)})
                    return
                self.send_error(404)

            def do_POST(self):
                if self.path != "/set_manual":
                    self.send_error(404)
                    return
                try:
                    length = int(self.headers.get("Content-Length", "0"))
                    payload = json.loads(self.rfile.read(length).decode("utf-8") or "{}")
                    result = plugin.set_manual_threadsafe(payload)
                    self._send(result, status=200 if result.get("ok") else 400)
                except Exception as exc:
                    self._send({"ok": False, "error": repr(exc)}, status=500)

            def log_message(self, fmt, *args):
                return

            def _send(self, payload: dict[str, Any], status: int = 200):
                data = json.dumps(payload, ensure_ascii=False, indent=2).encode("utf-8")
                self.send_response(status)
                self.send_header("Content-Type", "application/json; charset=utf-8")
                self.send_header("Content-Length", str(len(data)))
                self.end_headers()
                self.wfile.write(data)

        self.server = ThreadingHTTPServer((self.host, self.port), Handler)
        self.thread = threading.Thread(target=self.server.serve_forever, daemon=True)
        self.thread.start()
        print(f"LabPilot real BLACS bridge listening at http://{self.host}:{self.port}/status")
        print("LabPilot real BLACS bridge starts in READ-ONLY mode unless LABPILOT_BLACS_ALLOW_WRITE=1.")

    def _discover_candidates(self):
        if self.BLACS is None:
            return []
        return discover_blacs_manual_candidates(self.BLACS)

    def set_manual_threadsafe(self, payload: dict[str, Any]) -> dict[str, Any]:
        if not self.allow_write:
            return {
                "ok": False,
                "error": (
                    "Real BLACS bridge is currently read-only. Set LABPILOT_BLACS_ALLOW_WRITE=1 "
                    "before starting BLACS to enable experimental writes. Use only on low-risk test channels."
                ),
            }
        if QtCore is None or self.invoker is None:
            return self._set_manual_in_blacs_thread(payload)
        q: queue.Queue = queue.Queue(maxsize=1)
        self.invoker.set_requested.emit(dict(payload), q)
        try:
            return q.get(timeout=10)
        except queue.Empty:
            return {"ok": False, "error": "Timed out waiting for BLACS Qt thread to set manual value."}

    def _set_manual_in_blacs_thread(self, payload: dict[str, Any]) -> dict[str, Any]:
        name = str(payload.get("name", ""))
        if not name:
            return {"ok": False, "error": "missing channel name"}
        value = payload.get("value")
        candidates = self._discover_candidates()
        matches = [c for c in candidates if c.name == name or c.channel == name or c.object_path == name]
        if not matches:
            return {"ok": False, "error": f"No BLACS manual candidate named {name!r}. Use /channels first."}
        result = set_candidate_value(matches[0], value)
        result["program"] = bool(payload.get("program", False))
        result["warning"] = "Generic Qt setter used. Verify BLACS readback and hardware output manually."
        return result


def diagnostic_main():
    """This is not the real plugin entry point; it only explains how to install it."""
    print("This module is a BLACS plugin and must be loaded by BLACS.")
    print("It is not useful as a standalone process because it needs the BLACS object.")
    print("Install/configure labpilot_ai.blacs_bridge.plugin.Plugin as a BLACS plugin, then start BLACS.")
