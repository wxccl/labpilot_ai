        try:
            registry, report = discover_sequence_globals(self.project_settings, self.global_registry, project_dir=Path.cwd())
            self.global_registry = registry
            self.settings.save_global_registry(registry)
            self.validator = SafetyValidator(self.global_registry, self.blacs_registry, self.lyse_registry)
            try:
                self._fill_globals(self.rm.get_globals())
            except Exception:
                self._fill_globals({})
            summary = [
                f"files: {len(report.get('files', []))}",
                f"added: {len(report.get('added', []))}",
                f"updated: {len(report.get('updated', []))}",
            ]
            message = "AI parsed sequence variables:\n" + "\n".join(summary)
            self.log(message)
            QtWidgets.QMessageBox.information(self, "AI parsed sequence variables", message)
        except Exception as exc:
            if hasattr(self, "record_error"):
                self.record_error("AI parse sequence variables failed", exc)
            else:
                self.log(f"AI parse sequence variables failed: {exc}")
