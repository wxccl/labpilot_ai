    def _llm_api_status_text(self):
        client = getattr(self, "llm", None)
        if client is None:
            client = LLMClient(mock=False)
            self.llm = client
        status = client.status() if hasattr(client, "status") else {
            "mock": getattr(client, "mock", False),
            "api_key_found": bool(getattr(client, "api_key", None)),
            "api_key_source": getattr(client, "api_key_source", "unknown"),
            "base_url": getattr(client, "base_url", ""),
            "model": getattr(client, "model", ""),
        }
        if status.get("api_key_found"):
            return f"LLM real: {status.get('api_key_source')} | {status.get('model')} | {status.get('base_url')}"
        return "LLM real requested, but API key missing. Set DEEPSEEK_API_KEY or OPENAI_API_KEY and restart."

    def refresh_llm_status(self):
        self.llm = LLMClient(mock=False)
        text = self._llm_api_status_text()
        try:
            if not hasattr(self, "llm_status_label"):
                self.llm_status_label = QtWidgets.QLabel()
                self.statusBar().addPermanentWidget(self.llm_status_label)
            self.llm_status_label.setText(text)
        except Exception:
            pass
        self.log(text)
        return text

    def _force_real_connections(self):
        """Force real LLM/runmanager/BLACS mode and show safe API status."""
        for attr in ("mock_llm", "mock_rm", "mock_runmanager", "mock_blacs"):
            widget = getattr(self, attr, None)
            if widget is None:
                continue
            try:
                widget.blockSignals(True)
                widget.setChecked(False)
                widget.setEnabled(False)
                widget.setVisible(False)
                widget.blockSignals(False)
            except Exception:
                pass
        self.llm = LLMClient(mock=False)
        self.rm = RunmanagerBackend(mock=False)
        self.blacs = BlacsManualClient(mock=False)
        self.refresh_llm_status()
        self.log("Real modes forced: runmanager=real, BLACS=localhost bridge")

    def _install_runtime_status_widgets(self):
        """Install always-visible runtime/API status labels in the main UI."""
        try:
            if not hasattr(self, "llm_status_label"):
                self.llm_status_label = QtWidgets.QLabel("LLM: checking...")
                self.llm_status_label.setObjectName("llm_status_label")
                self.llm_status_label.setMinimumWidth(360)
                self.statusBar().addPermanentWidget(self.llm_status_label, 1)
            self.refresh_llm_api_status_ui(log=True)
        except Exception as exc:
            try:
                self.log(f"LLM status UI setup failed: {exc}")
            except Exception:
                pass

    def _llm_runtime_status(self):
        """Return sanitized LLM runtime status without exposing the full API key."""
        client = LLMClient(mock=False)
        if hasattr(client, "status"):
            status = dict(client.status())
        else:
            status = {
                "mock": bool(getattr(client, "mock", False)),
                "api_key_found": bool(getattr(client, "api_key", None)),
                "api_key_source": getattr(client, "api_key_source", ""),
                "base_url": getattr(client, "base_url", ""),
                "model": getattr(client, "model", ""),
            }
        source = status.get("api_key_source") or ""
        if not source:
            if os.getenv("DEEPSEEK_API_KEY"):
                source = "DEEPSEEK_API_KEY"
            elif os.getenv("OPENAI_API_KEY"):
                source = "OPENAI_API_KEY"
            else:
                source = "missing"
        raw_key = os.getenv(source, "") if source.endswith("_API_KEY") else ""
        if raw_key:
            masked = raw_key[:8] + "..." + raw_key[-4:] if len(raw_key) > 12 else "***"
        else:
            masked = "missing"
        status["api_key_source"] = source
        status["api_key_masked"] = masked
        status["api_key_found"] = bool(raw_key or status.get("api_key_found"))
        return status

    def refresh_llm_api_status_ui(self, log=False):
        """Refresh visible LLM API status from system environment variables."""
        try:
            status = self._llm_runtime_status()
            found = bool(status.get("api_key_found")) and not bool(status.get("mock"))
            source = status.get("api_key_source", "missing")
            model = status.get("model", "") or "unknown-model"
            base_url = status.get("base_url", "") or "unknown-base-url"
            masked = status.get("api_key_masked", "missing")
            if found:
                text = f"LLM: REAL API loaded | {source} | {model}"
                style = "color: #1B7F3A; font-weight: 600;"
            else:
                text = "LLM: API key missing"
                style = "color: #BF1D2D; font-weight: 600;"
            if hasattr(self, "llm_status_label"):
                self.llm_status_label.setText(text)
                self.llm_status_label.setToolTip(
                    f"source={source}\nmodel={model}\nbase_url={base_url}\nkey={masked}"
                )
                self.llm_status_label.setStyleSheet(style)
            if log:
                self.log(f"{text} | base_url={base_url} | key={masked}")
            return status
        except Exception as exc:
            if hasattr(self, "llm_status_label"):
                self.llm_status_label.setText(f"LLM: status error: {exc}")
                self.llm_status_label.setStyleSheet("color: #BF1D2D; font-weight: 600;")
            if log:
                try:
                    self.log(f"LLM status error: {exc}")
                except Exception:
                    pass
            return {"error": str(exc)}

