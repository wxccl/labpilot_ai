    def _on_globals_table_item_changed(self, item):
        if getattr(self, "_loading_globals_table", False):
            return
        if item is None or item.column() != 1:
            return
        row = item.row()
        name_item = self.globals_table.item(row, 0)
        if not name_item:
            return
        name = name_item.text().strip()
        if name not in self.global_registry:
            self.log(f"Auto upload skipped: {name} is not in global registry.")
            return
        self._pending_global_edit = (row, name, item.text())
        if hasattr(self, "global_upload_timer"):
            self.global_upload_timer.start()
        else:
            self._global_value_changed_timer_timeout()

    def _global_value_changed_timer_timeout(self):
        payload = getattr(self, "_pending_global_edit", None)
        self._pending_global_edit = None
        if not payload:
            return
        row, name, value = payload
        current_name_item = self.globals_table.item(row, 0) if hasattr(self, "globals_table") else None
        if not current_name_item or current_name_item.text().strip() != name:
            return
        self.auto_upload_global_from_table_value(name, value)

    def auto_upload_global_from_table_value(self, name, value):
        try:
            action = {"type": "set_global", "name": name, "value": str(value).strip().strip("'\"")}
            self.last_safe = self.validator.validate_command({"actions": [action]})
            self._fill_actions(self.last_safe)
            self.log(f"Auto uploading global: {name} = {action['value']}")
            self.execute_last(force_run=False)
            self.update_runmanager_shot_preview(silent=True)
        except Exception as exc:
            self._show_error(f"Auto upload global failed: {name}", exc)

